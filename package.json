{
  "name": "@kvnwolf/devtools",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "lint": "biome check",
    "setup": "bun run scripts/setup.ts",
    "types": "tsgo --build",
    "test": "vitest run",
    "unused": "knip",
    "update": "taze --interactive"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.6",
    "@types/bun": "^1.3.10",
    "@typescript/native-preview": "^7.0.0-dev.20260305.1",
    "knip": "^5.85.0",
    "simple-git-hooks": "^2.13.1",
    "taze": "^19.10.0",
    "turbo": "^2.8.13",
    "ultracite": "^7.2.5",
    "vitest": "^4.0.18"
  },
  "simple-git-hooks": {
    "pre-commit": "bun run turbo validate"
  },
  "knip": {
    "ignoreDependencies": [
      "turbo"
    ]
  },
  "packageManager": "bun@1.3.10"
}
